<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent público a propósito. Los proyectos reales bajo prueba heredan de un parent
      corporativo que vive en un Nexus privado; este banco de pruebas existe para ejercitar
      el PIPELINE, no ese framework, y debe poder construirse sin credenciales.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.10</version>
        <relativePath/>
    </parent>

    <groupId>es.iti.wakamiti.bancopruebas</groupId>
    <artifactId>banco-pruebas-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>banco-pruebas-api</name>
    <description>Proyecto Java de referencia para validar el pipeline de cobertura y regresion selectiva</description>

    <properties>
        <java.version>17</java.version>
        <wakamiti.plugin.version>2.9.0</wakamiti.plugin.version>
        <!-- El .exec de la bateria Wakamiti va aparte del de los tests unitarios. -->
        <jacoco.wakamiti.execution.data.file>${project.build.directory}/coverage-reports/jacoco-wakamiti.exec</jacoco.wakamiti.execution.data.file>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Perfil que activa la bateria Wakamiti. El pipeline lo invoca con -Pwakamiti; sin el,
          `mvn test` solo corre los tests unitarios y no arranca nada.
        -->
        <profile>
            <id>wakamiti</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <configuration>
                            <destFile>${jacoco.wakamiti.execution.data.file}</destFile>
                            <append>true</append>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>es.iti.wakamiti</groupId>
                        <artifactId>wakamiti-maven-plugin</artifactId>
                        <version>${wakamiti.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>wakamiti-verify</id>
                                <goals>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <logLevel>info</logLevel>
                            <properties>
                                <tagFilter>not ignore</tagFilter>
                                <!--
                                  workingDir gana sobre cualquier -D de la linea de comandos: las
                                  rutas de salida de abajo son relativas a el, y el pipeline lee
                                  los resultados por test case de target/wakamiti/multipleJsons.
                                -->
                                <workingDir>wakamiti</workingDir>
                                <htmlReport.title>${project.name} ${project.version}</htmlReport.title>
                                <htmlReport.output>../target/wakamiti/${project.name}_%DATE%%TIME%.html</htmlReport.output>
                                <outputFilePath>../target/wakamiti/wakamiti.json</outputFilePath>
                                <outputFilePerTestCasePath>../target/wakamiti/multipleJsons/%DATE%%TIME%</outputFilePerTestCasePath>
                            </properties>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>es.iti.wakamiti</groupId>
                                <artifactId>rest-wakamiti-plugin</artifactId>
                                <version>2.9.3</version>
                            </dependency>
                            <dependency>
                                <groupId>es.iti.wakamiti</groupId>
                                <artifactId>db-wakamiti-plugin</artifactId>
                                <version>3.7.0</version>
                            </dependency>
                            <dependency>
                                <groupId>es.iti.wakamiti</groupId>
                                <artifactId>html-report-wakamiti-plugin</artifactId>
                                <version>2.8.0</version>
                            </dependency>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>42.5.4</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
