<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent público a propósito. Los proyectos reales bajo prueba heredan de un parent
      corporativo que vive en un Nexus privado; este banco de pruebas existe para ejercitar
      el PIPELINE, no ese framework, y debe poder construirse sin credenciales.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.10</version>
        <relativePath/>
    </parent>

    <groupId>es.iti.wakamiti.bancopruebas</groupId>
    <artifactId>banco-pruebas-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>banco-pruebas-api</name>
    <description>Proyecto Java de referencia para validar el pipeline de cobertura y regresion selectiva</description>

    <properties>
        <java.version>17</java.version>
        <wakamiti.plugin.version>2.9.0</wakamiti.plugin.version>
        <!--
          Ruta del wakamiti.yaml. El pipeline la sobreescribe por línea de comandos; el valor
          de aquí es el que sirve cuando se lanza la batería a mano desde el propio proyecto.
        -->
        <wakamiti.configurationProfile>${project.basedir}/wakamiti/wakamiti.yaml</wakamiti.configurationProfile>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Declarado en el build BASE, no dentro del perfil: la fase de cobertura del
              pipeline invoca `mvn jacoco:report` sin activar ningún perfil, y por prefijo.
              Dentro del perfil el prefijo no resuelve y el informe sale vacío sin error.
              No se vincula prepare-agent: el agente lo inyecta el pipeline por
              JAVA_TOOL_OPTIONS, y vincularlo aquí daría doble instrumentación.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Perfil que activa la bateria Wakamiti. El pipeline lo invoca con -Pwakamiti; sin el,
          `mvn test` solo corre los tests unitarios y no arranca nada.
        -->
        <profile>
            <id>wakamiti</id>
            <build>
                <plugins>
                    <!--
                      Aquí instrumenta el PIPELINE, inyectando el agente por JAVA_TOOL_OPTIONS.
                      Los proyectos reales lo hacen al revés (lo gestiona su pom), así que ese
                      camino del pipeline no lo ejercita nadie y es el que este banco de pruebas
                      viene a cubrir.
                    -->
                    <plugin>
                        <groupId>es.iti.wakamiti</groupId>
                        <artifactId>wakamiti-maven-plugin</artifactId>
                        <version>${wakamiti.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>wakamiti-verify</id>
                                <goals>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <logLevel>info</logLevel>
                            <!--
                              Sin esto el plugin no carga el wakamiti.yaml y el plan muere con
                              "No resource types configured": no llega a descubrir ni una feature.
                            -->
                            <configurationFiles>${wakamiti.configurationProfile}</configurationFiles>
                            <properties>
                                <tagFilter>not ignore</tagFilter>
                                <!--
                                  workingDir gana sobre cualquier -D de la linea de comandos: las
                                  rutas de salida de abajo son relativas a el, y el pipeline lee
                                  los resultados por test case de target/wakamiti/multipleJsons.
                                -->
                                <workingDir>wakamiti</workingDir>
                                <htmlReport.title>${project.name} ${project.version}</htmlReport.title>
                                <htmlReport.output>../target/wakamiti/${project.name}_%DATE%%TIME%.html</htmlReport.output>
                                <outputFilePath>../target/wakamiti/wakamiti.json</outputFilePath>
                                <outputFilePerTestCasePath>../target/wakamiti/multipleJsons/%DATE%%TIME%</outputFilePerTestCasePath>
                            </properties>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>es.iti.wakamiti</groupId>
                                <artifactId>rest-wakamiti-plugin</artifactId>
                                <version>2.9.3</version>
                            </dependency>
                            <dependency>
                                <groupId>es.iti.wakamiti</groupId>
                                <artifactId>db-wakamiti-plugin</artifactId>
                                <version>3.7.0</version>
                            </dependency>
                            <dependency>
                                <groupId>es.iti.wakamiti</groupId>
                                <artifactId>html-report-wakamiti-plugin</artifactId>
                                <version>2.8.0</version>
                            </dependency>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>42.5.4</version>
                            </dependency>
                        </dependencies>
                    </plugin>

                    <!--
                      Arranca la aplicación antes de la batería y la para después. Sin esto
                      Wakamiti lanza sus peticiones contra un puerto donde no escucha nadie y
                      todos los escenarios REST fallan con "Connection refused".
                    -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <fork>true</fork>
                            <wait>60000</wait>
                            <systemPropertyVariables>
                                <server.port>8080</server.port>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pre-integration-test</id>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>post-integration-test</id>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>
</project>
